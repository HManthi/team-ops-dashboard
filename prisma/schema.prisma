generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
}

enum TicketStatus {
  open
  in_progress
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketEventType {
  ticket_created
  status_changed
  assigned_changed
  priority_changed
  title_changed
  description_changed
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(member)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets  Ticket[]      @relation("TicketCreatedBy")
  assignedTickets Ticket[]      @relation("TicketAssignedTo")
  events          TicketEvent[] @relation("TicketEventActor")
}

model Ticket {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  status       TicketStatus  @default(open)
  priority     TicketPriority @default(medium)

  createdById  Int
  createdBy    User          @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User?         @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       TicketEvent[]
}

model TicketEvent {
  id          Int            @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket         @relation(fields: [ticketId], references: [id])

  eventType   TicketEventType

  actorUserId Int
  actor       User           @relation("TicketEventActor", fields: [actorUserId], references: [id])

  oldValue    String?
  newValue    String?

  createdAt   DateTime       @default(now())

  @@index([ticketId])
  @@index([actorUserId])
}
